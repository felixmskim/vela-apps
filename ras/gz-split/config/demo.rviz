# RViz layout for the demonstration: what the GUEST believes, beside what the
# simulator is doing.
#
# The Gazebo GUI shows ground truth -- the robot moving through the world. It
# cannot show the map slam_toolbox built, the path Nav2 planned, or what the
# detector found, because those are the guest's opinions and they arrive back
# over the TCP link. This file puts all three in one window.
#
# Where each topic comes from, because it decides what the guest pays for:
#
#   /scan             the HOST bridge. RViz reads it locally, guest cost zero.
#   /map              the GUEST (slam_toolbox). TRANSIENT_LOCAL, ~11 kB per
#                     update -- the durability MUST match or the display stays
#                     empty with no error shown.
#   /plan             the GUEST (planner_server), on each replan.
#   /detection_image  the HOST (detection_overlay.py). The guest publishes only
#                     the small Detection2DArray; the drawing happens here.
#
# THIS FILE IS FOR DRIVING RVIZ BY HAND, over VNC, with a mouse. It cannot film
# a detector run and run_demo.sh never selects it. Two reasons, both measured
# 2026-08-19: the Image display below is `Enabled: false` with its dock
# `collapsed: true`, and undoing either means clicking in the Displays panel --
# which nobody can do on the headless Xvfb display run_demo.sh records. Enabled
# and expanded it was no better: as the only dock in an 864 px pane Qt stretched
# it to ~320x1000 for a 320x240 image, so a third of the frame became empty
# beige and the map lost 300 px to it (artifacts/rviz-yolo-smoke.png).
#
# Recordings use demo_nav.rviz, and OVERLAY=1 gives the detections their own
# small window on the same display instead of a dock in this one.
#
# Load it with:  rviz2 -d /work/config/demo.rviz
Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded: ~
    Tree Height: 600
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 10
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 100; 100; 100

    - Class: rviz_default_plugins/Map
      Name: SLAM map
      Enabled: true
      Alpha: 0.8
      Color Scheme: map
      Topic:
        Value: /map
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Transient Local

    - Class: rviz_default_plugins/LaserScan
      Name: Lidar
      Enabled: true
      Size (m): 0.04
      Style: Points
      Color: 255; 90; 90
      Color Transformer: FlatColor
      Decay Time: 0
      Topic:
        Value: /scan
        Depth: 5
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Durability Policy: Volatile

    - Class: rviz_default_plugins/Path
      Name: Nav2 plan
      Enabled: true
      Color: 90; 230; 120
      Line Style: Lines
      Topic:
        Value: /plan
        Depth: 1
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.4

    - Class: rviz_default_plugins/Image
      Name: YOLO detections
      # Off by default. /detection_image only exists while the guest is running a
      # detector and run_demo.sh has started detection_overlay.py; with neither,
      # an enabled Image display is a grey "No Image" tile in the corner of every
      # recorded frame. Tick it in the Displays panel, or set Enabled: true here,
      # when there is a detector to watch.
      Enabled: false
      Max Value: 1
      Min Value: 0
      Normalize Range: true
      Topic:
        Value: /detection_image
        Depth: 2
        History Policy: Keep Last
        Reliability Policy: Reliable
        Durability Policy: Volatile

  Tools:
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      # 7.5 frames tb3_sandbox, the world the recording recipe uses; depot is
      # roughly three times the span and wants ~30. One saved view cannot suit
      # both, and the map is what the pane is for.
      Distance: 7.5
      Focal Point:
        X: 1
        Y: 0
        Z: 0
      Pitch: 1.2
      Yaw: 1.6
      Target Frame: map

# Deliberately small: run_demo.sh tiles both windows with xdotool once they
# exist, and until it does, whatever is written here is what sits on the display.
# At 1500x900 RViz covered the Gazebo GUI completely on a bare Xvfb, which has no
# window manager to arrange them. Do not put X/Y here; placement is the runner's.
Window Geometry:
  Height: 700
  Width: 640
  Displays:
    collapsed: false
  YOLO detections:
    collapsed: true
